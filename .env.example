# Copy to .env. Shopify CLI supplies the Shopify values after account linking.
DATABASE_URL="file:./dev.sqlite"
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=read_products,read_orders,write_app_proxy
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep stable: encrypts OAuth/email/link values and HMACs scoped anti-duplication values.
DATA_ENCRYPTION_KEY=
WORLD_PROVIDER=mock
# selfie uses World Selfie Check Beta; proof_of_human uses Orb-backed v4.
# Choose one credential before launch; switching does not link identities across credentials.
WORLD_CREDENTIAL=proof_of_human
# sandbox requires the World ID Sandbox mobile app; test reviews remain private.
WORLD_ENVIRONMENT=production
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_SIGNING_KEY=
# Confirm the proof_of_human issuer schema ID with your World configuration.
WORLD_ISSUER_SCHEMA_ID=1
# Set resend to email the order's address; development only writes local files.
EMAIL_PROVIDER=development
RESEND_API_KEY=
# A verified sender in your Resend account, e.g. Reviews <reviews@your-domain.com>
EMAIL_FROM=
# Real email requires a publicly reachable HTTPS SHOPIFY_APP_URL above.
DEV_OUTBOX_DIR=work/outbox
